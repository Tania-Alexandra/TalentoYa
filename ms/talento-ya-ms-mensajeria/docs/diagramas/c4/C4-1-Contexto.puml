@startuml C4-1-Contexto
!include <C4/C4_Context>

title ms-mensajeria — C4 Nivel 1: Contexto

LAYOUT_WITH_LEGEND()

System(sys, "ms-mensajeria", "Mensajería del caso caso02: hace llegar la información a las personas: consume los eventos de dominio publicados por los demás servicios y los entrega por correo electrónico y notificaciones push, sin acoplarse a ningún productor")

System_Ext(core, "ms-postulaciones", "Postulaciones del caso (servicio central)")
System_Ext(notif, "ms-notificaciones", "Notificaciones del caso")
System_Ext(cognito, "Amazon Cognito", "Autenticación y JWT por rol")
System_Ext(bus, "Amazon EventBridge", "Bus de eventos de dominio")

Rel(sys, core, "Postulaciones del caso (servicio central)", "REST / eventos")
Rel_Back(notif, sys, "Notificaciones del caso", "EventBridge / SQS")
Rel_Back(cognito, sys, "Autenticación y JWT por rol", "JWT")
Rel(sys, bus, "Bus de eventos de dominio", "AWS SDK")

SHOW_LEGEND()
@enduml
